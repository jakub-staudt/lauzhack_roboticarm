# Copy to .env (development) or to the service's EnvironmentFile (server).
# Every key is RAMION_DASHBOARD_<SECTION>__<FIELD>; unset keys use the defaults shown here.
# Upstream defaults are the production addresses on ramion-server-01.

# --- server: where the HTTP server listens ---
# Production binds the Tailscale IP: 100.85.56.14
RAMION_DASHBOARD_SERVER__HOST=127.0.0.1
RAMION_DASHBOARD_SERVER__PORT=8780
# DEBUG | INFO | WARNING | ERROR
RAMION_DASHBOARD_SERVER__LOG_LEVEL=INFO
# Exposes /docs and /openapi.json. Keep off outside development: the dashboard has no auth.
RAMION_DASHBOARD_SERVER__DOCS_ENABLED=false
# Directory with scan.html, board-map.html, board-map.js. Default: the copy inside the package.
# RAMION_DASHBOARD_SERVER__STATIC_DIR=

# --- controller: soarm-panel, owner of the arm and cameras ---
RAMION_DASHBOARD_CONTROLLER__BASE_URL=http://100.85.56.14:8765
RAMION_DASHBOARD_CONTROLLER__TIMEOUT_S=8
RAMION_DASHBOARD_CONTROLLER__COMMAND_BODY_LIMIT_BYTES=8192

# --- viewer: read-only Viser, relayed under /viewer/ ---
RAMION_DASHBOARD_VIEWER__BASE_URL=http://100.85.56.14:8766
RAMION_DASHBOARD_VIEWER__IO_TIMEOUT_S=8
RAMION_DASHBOARD_VIEWER__IDLE_TIMEOUT_S=90
RAMION_DASHBOARD_VIEWER__PAGE_LIMIT_BYTES=4194304

# --- camera: MJPEG pacing ---
# Comma-separated; JSON lists are rejected. Both defaults must be in this list.
RAMION_DASHBOARD_CAMERA__AVAILABLE_FPS=2,10,15
RAMION_DASHBOARD_CAMERA__DEFAULT_FPS=2
RAMION_DASHBOARD_CAMERA__DIRECT_DEFAULT_FPS=10
RAMION_DASHBOARD_CAMERA__FRAME_TIMEOUT_S=3
RAMION_DASHBOARD_CAMERA__FRAME_LIMIT_BYTES=2000000

# --- scan: automatic board collection ---
RAMION_DASHBOARD_SCAN__STORAGE_DIR=~/ramion-scans
# 1..120 seconds
RAMION_DASHBOARD_SCAN__DURATION_S=60
