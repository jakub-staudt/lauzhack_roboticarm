# Production settings of ramion-dashboard.service on ramion-server-01.
# Install as /home/kwikiel/.config/ramion/dashboard.env (mode 600, owner kwikiel).
# Every other setting keeps its default; the full list is apps/arm-dashboard/.env.example.
# The legacy server.py ignores this file.

# The Tailscale address the dashboard has always served on.
RAMION_DASHBOARD_SERVER__HOST=100.85.56.14
RAMION_DASHBOARD_SERVER__PORT=8780

# soarm-panel and its read-only Viser viewer on this host.
RAMION_DASHBOARD_CONTROLLER__BASE_URL=http://100.85.56.14:8765
RAMION_DASHBOARD_VIEWER__BASE_URL=http://100.85.56.14:8766

# Existing scan sessions stay where the legacy dashboard wrote them.
RAMION_DASHBOARD_SCAN__STORAGE_DIR=/home/kwikiel/ramion-scans
